# Server
PROJECT_NAME=Gaffer Sports Intelligence
ENVIRONMENT=development
API_V1_STR=/api
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gaffer
POSTGRES_PASSWORD=gaffer_dev_password
POSTGRES_DB=gaffer_db
DATABASE_URL=postgresql://gaffer:gaffer_dev_password@localhost:5432/gaffer_db

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Object Storage (AWS S3 or Local MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=gaffer-matches
S3_REGION=us-east-1
S3_USE_SSL=False

# CV & ML Settings
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
STORAGE_LOCAL_DIR=/tmp/gaffer/storage
